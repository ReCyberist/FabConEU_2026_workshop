# MkDocs build output
site/

# Python
.venv/
__pycache__/
*.pyc

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
# Local demo backend overrides (e.g. backend_local_override.tf); .example stays tracked
*_override.tf
!*_override.tf.example

# Azure / secrets — never commit
*.publishsettings
*.azureauth
.env
*.pem
*.key

# SQL project build output
bin/
obj/
*.dacpac
*.StaticCodeAnalysis.Results.xml

# Packaged attendee downloads (produced by pipeline)
dist/
*.zip

# Local Claude Code settings (personal, not shared)
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.vs/
.idea/

# PowerPoint — the conference template and the generated deck stay out of git.
# The deck is generated from slides/content.py + slides/build.py; see slides/README.md
*.pptx
*.potx
*.ppt

# SqlPackage deploy reports — the ship-changes demo writes these into the
# tracked database/sql-projects folder. They are demo output, never source.
deploy-report*.xml
