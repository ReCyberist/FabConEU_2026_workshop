<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.Build.Sql/0.2.0-preview">
  <PropertyGroup>
    <Name>FabConFootball</Name>
    <!-- Azure SQL Database DSP is the common denominator; it also publishes cleanly to
         Fabric SQL database. See notes/fabric-sql-notes.md for the surface-area watch-list. -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <!-- Run T-SQL static code analysis on every build so smells surface early
         (build with -warnaserror in CI to make any finding fail the pipeline). -->
    <RunSqlCodeAnalysis>True</RunSqlCodeAnalysis>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <!-- The pre-deployment migration and post-deployment seed are data/DML, not schema:
       exclude them from the build model and run them around the schema change. -->
  <ItemGroup>
    <Build Remove="Scripts\**\*.sql" />
    <PreDeploy Include="Scripts\PreDeployment\Migrate-ShirtNumber.sql" />
    <PostDeploy Include="Scripts\PostDeployment\Seed.sql" />
  </ItemGroup>
</Project>