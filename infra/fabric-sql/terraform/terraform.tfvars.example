# Copy to terraform.tfvars and adjust. Apart from the one required value below, every
# setting has a sensible default (the capacity admin defaults to your own signed-in
# principal).
#
# Auth is passwordless. Before running:
#   az login
#   $env:ARM_SUBSCRIPTION_ID = "<your-subscription-guid>"   # state backend / CLI
#   # optional: $env:FABRIC_TENANT_ID = "<your-tenant-guid>"

# --- Required: subscription for the Fabric capacity (azurerm provider) ---
# This has NO default. The module's azurerm provider builds the capacity here. It is a
# separate value from ARM_SUBSCRIPTION_ID (which feeds the state backend / CLI), so setting
# ARM_SUBSCRIPTION_ID alone leaves this unset and `terraform plan` prompts for it. For a
# local single-tenant demo it is the same subscription. Set it here, or via the environment:
#   $env:TF_VAR_fabric_subscription_id = $env:ARM_SUBSCRIPTION_ID
fabric_subscription_id = "<your-subscription-guid>"

# --- Naming (matches the Azure SQL module) ---
workload              = "fabcon26"
environment           = "dev"
location              = "westeurope"
location_abbreviation = "weu"
database_name         = "football"

# --- Fabric capacity ---
# F2 is the smallest/cheapest SKU. Pause the capacity when idle to stop billing.
capacity_sku = "F2"

# Entra admins for the capacity (UPNs or SP object IDs). Leave unset to use your own
# principal. A group is recommended for a shared workshop.
# capacity_admin_members = ["you@contoso.com"]

# --- Existing-capacity mode (optional) ---
# Bind the workspace to a capacity that ALREADY exists instead of creating one. Use this for a
# paid F-SKU you manage and PAUSE out-of-band (billing stops on pause; the capacity is never
# destroyed by this module). When true, capacity_sku / capacity_admin_members are ignored, and
# the resource group + capacity are NOT created — only the workspace + SQL database.
# use_existing_capacity            = true
# existing_capacity_name           = "cappymccapface"   # the capacity's display name (looked up tenant-wide)
# existing_capacity_resource_group = "fabcon-demo-rg"    # informational; also where the #23 pause/resume automation targets

# --- Workspace access ---
# The CI service principal that runs Terraform is the workspace's only admin, so humans can't
# see it until granted a role. Grant it as code (survives workspace recreation). List Entra
# USER object ids (GUIDs, not UPNs): az ad user show --id you@contoso.com --query id -o tsv
# workspace_admin_object_ids = ["00000000-0000-0000-0000-000000000000"]

# --- SQL database ---
database_collation             = "SQL_Latin1_General_CP1_CI_AS"
database_backup_retention_days = 7

tags = {
  owner = "jess-and-rob"
}
